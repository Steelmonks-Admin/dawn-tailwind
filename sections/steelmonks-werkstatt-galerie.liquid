{%- comment -%}
  Werkstatt-Galerie: reine Bildergalerie ohne Produkte. Jeder Block ist ein Bild –
  entweder aus dem Theme-Editor (image_picker) oder eine Datei aus assets/ (Feld "asset").
  Klick öffnet das Bild groß in einem <dialog>. Keine Links zu Produkten, nichts kaufbar.
{%- endcomment -%}

{%- style -%}
  #smk-wg-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  #smk-wg-{{ section.id }} .smk-wg__head { text-align: {{ section.settings.alignment }}; margin-bottom: 20px; }
  #smk-wg-{{ section.id }} .smk-wg__head p { max-width: 62ch; margin: 8px auto 0; {% if section.settings.alignment == 'left' %}margin-left: 0;{% endif %} }
  #smk-wg-{{ section.id }} .smk-wg__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr); gap: 12px; list-style: none; margin: 0; padding: 0; }
  @media (min-width: 750px) { #smk-wg-{{ section.id }} .smk-wg__grid { grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: 16px; } }
  .smk-wg__item { position: relative; display: block; width: 100%; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 12px; border: 0; padding: 0; background: #ececec; cursor: zoom-in; }
  .smk-wg__item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s ease; }
  .smk-wg__item:hover img, .smk-wg__item:focus-visible img { transform: scale(1.03); }
  .smk-wg__item:focus-visible { outline: 3px solid rgb(var(--color-foreground)); outline-offset: 2px; }
  .smk-wg__cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 12px 10px; font-size: .82rem; line-height: 1.3; color: #fff; text-align: left; background: linear-gradient(transparent, rgba(0,0,0,.62)); opacity: 0; transition: opacity .2s ease; }
  .smk-wg__item:hover .smk-wg__cap, .smk-wg__item:focus-visible .smk-wg__cap { opacity: 1; }
  @media (hover: none) { .smk-wg__cap { display: none; } }
  .smk-wg__actions { text-align: center; margin-top: 24px; }
  dialog.smk-wg__dialog { border: 0; padding: 0; background: transparent; max-width: min(92vw, 860px); width: 100%; }
  dialog.smk-wg__dialog::backdrop { background: rgba(0,0,0,.82); }
  dialog.smk-wg__dialog figure { margin: 0; position: relative; }
  dialog.smk-wg__dialog img { width: 100%; height: auto; display: block; border-radius: 12px; }
  dialog.smk-wg__dialog figcaption { color: #fff; text-align: center; padding: 12px 8px 0; font-size: .95rem; }
  .smk-wg__close { position: absolute; top: 10px; right: 10px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(0,0,0,.6); color: #fff; font-size: 26px; line-height: 40px; cursor: pointer; }
  .smk-wg__close:hover { background: rgba(0,0,0,.85); }
{%- endstyle -%}

<div id="smk-wg-{{ section.id }}" class="page-width smk-wg color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="smk-wg__head">
      {%- if section.settings.heading != blank -%}<h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
  {%- endif -%}

  <ul class="smk-wg__grid" role="list">
    {%- for block in section.blocks limit: section.settings.max_items -%}
      {%- liquid
        assign src = ''
        assign src_big = ''
        if block.settings.image != blank
          assign src = block.settings.image | image_url: width: 700
          assign src_big = block.settings.image | image_url: width: 1400
        elsif block.settings.asset != blank
          assign src = block.settings.asset | asset_url
          assign src_big = src
        endif
        assign cap = block.settings.caption | strip | escape
      -%}
      {%- if src != blank -%}
        <li {{ block.shopify_attributes }}>
          <button type="button" class="smk-wg__item" data-full="{{ src_big }}" data-caption="{{ cap }}" aria-label="{% if cap != blank %}{{ cap }} – {% endif %}Bild vergrößern">
            <img src="{{ src }}" alt="{{ cap }}" width="700" height="700" loading="lazy">
            {%- if cap != blank -%}<span class="smk-wg__cap" aria-hidden="true">{{ cap }}</span>{%- endif -%}
          </button>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

  {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
    <div class="smk-wg__actions"><a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></div>
  {%- endif -%}

  <dialog class="smk-wg__dialog" aria-label="Bildansicht">
    <figure>
      <button type="button" class="smk-wg__close" aria-label="Schließen">&times;</button>
      <img src="" alt="">
      <figcaption></figcaption>
    </figure>
  </dialog>
</div>

<script>
  (function () {
    var root = document.getElementById('smk-wg-{{ section.id }}');
    if (!root) return;
    var dialog = root.querySelector('dialog.smk-wg__dialog');
    var img = dialog.querySelector('img');
    var cap = dialog.querySelector('figcaption');
    if (typeof dialog.showModal !== 'function') return;
    root.querySelectorAll('.smk-wg__item').forEach(function (btn) {
      btn.addEventListener('click', function () {
        img.src = btn.getAttribute('data-full');
        img.alt = btn.getAttribute('data-caption') || '';
        cap.textContent = btn.getAttribute('data-caption') || '';
        dialog.showModal();
      });
    });
    dialog.querySelector('.smk-wg__close').addEventListener('click', function () { dialog.close(); });
    dialog.addEventListener('click', function (e) { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', function () { img.src = ''; });
  })();
</script>

{% schema %}
{
  "name": "Werkstatt Galerie",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Aus der Werkstatt: Schilder unserer Kunden" },
    { "type": "select", "id": "heading_size", "label": "Größe der Überschrift", "options": [ { "value": "h1", "label": "Groß" }, { "value": "h2", "label": "Mittel" }, { "value": "h3", "label": "Klein" } ], "default": "h2" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "alignment", "label": "Ausrichtung", "options": [ { "value": "left", "label": "Links" }, { "value": "center", "label": "Mitte" } ], "default": "left" },
    { "type": "range", "id": "columns_desktop", "label": "Spalten am Desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Spalten am Handy", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "2" },
    { "type": "range", "id": "max_items", "label": "Höchstens so viele Bilder zeigen", "min": 1, "max": 60, "step": 1, "default": 60 },
    { "type": "text", "id": "button_label", "label": "Knopf-Beschriftung (optional)" },
    { "type": "url", "id": "button_link", "label": "Knopf-Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "bild",
      "name": "Bild",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "asset", "label": "Oder Theme-Datei (assets/…)", "info": "Dateiname einer Datei im Theme-Ordner assets, z. B. wg-01-grill-chill.jpg. Wird nur genutzt, wenn oben kein Bild gewählt ist." },
        { "type": "text", "id": "caption", "label": "Bildunterschrift" }
      ]
    }
  ],
  "max_blocks": 60,
  "presets": [ { "name": "Werkstatt Galerie" } ]
}
{% endschema %}
