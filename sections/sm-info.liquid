{%- comment -%} Steelmonks: Montage & Pflege und Oberflächen. Inhalte in snippets/sm-info-*.liquid (aus dem Prototyp erzeugt, port_info.py). {%- endcomment -%}
<link rel="preload" href="{{ 'sm-bigshoulders-900.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
{{ 'sm-sonder.css' | asset_url | stylesheet_tag }}
{{ 'sm-info.css' | asset_url | stylesheet_tag }}
{%- case section.settings.seite -%}
  {%- when 'oberflaechen' -%}{%- render 'sm-info-oberflaechen' -%}
  {%- else -%}{%- render 'sm-info-media' -%}
{%- endcase -%}
{%- render 'sm-info-data' -%}
<script src="{{ 'sm-info.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SM Info-Seite",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "select", "id": "seite", "label": "Seite", "default": "media", "options": [
      { "value": "media", "label": "Montage & Pflege" },
      { "value": "oberflaechen", "label": "Oberflächen" } ] }
  ],
  "presets": [ { "name": "SM Info-Seite" } ]
}
{% endschema %}
