{{ 'sm-cart.css' | asset_url | stylesheet_tag }}

{% style %}
  /* J.1l — inline mobile compact rules (cache-proof) */
  @media screen and (max-width: 749px) {
    #main-cart-items [class*='-padding'] {
      padding-top: 2px !important;
      padding-bottom: 8px !important;
    }
    .title-wrapper-with-link {
      margin: 2px 0 4px !important;
      row-gap: 0 !important;
    }
    .title-wrapper-with-link .title--primary {
      margin: 0 !important;
      font-size: 2.6rem !important;
    }
    .cart-items thead th {
      padding-top: 4px !important;
      padding-bottom: 6px !important;
    }
    .cart-item {
      gap: 0.8rem !important;
      margin-bottom: 1.4rem !important;
    }
    .cart-item > td {
      padding-top: 10px !important;
      padding-bottom: 6px !important;
    }
    .cart-item__media {
      width: 8.4rem !important;
    }
    .cart-item__image-container,
    .cart-item__image {
      width: 76px !important;
      max-width: 76px !important;
      height: auto !important;
    }
    .cart-item__details {
      padding-left: 10px !important;
      font-size: 1.3rem;
    }
    .cart-item__details > * {
      margin-top: 3px !important;
      margin-bottom: 0 !important;
    }
    .cart-item__details etrusted-widget {
      display: none !important;
    }
    .cart-item .cart-item__quantity {
      padding-top: 4px !important;
    }
  }
{% endstyle %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src='{{ 'cart.js' | asset_url }}' defer='defer'></script>
{%- endunless -%}

<script src='{{ 'quantity-popover.js' | asset_url }}' defer='defer'></script>

<cart-items
  style='z-index: 1'
  class='gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}'
>
  <div class='page-width'>
    <div class='title-wrapper-with-link'>
      {%- capture smc_count -%}{%- render 'sm-cart-count' -%}{%- endcapture -%}
      {%- assign smc_count = smc_count | strip | plus: 0 -%}
      <h1 class='title title--primary'>{{ 'sections.cart.title' | t }}{% if smc_count > 0 %} ({{ smc_count }}){% endif %}</h1>
      <a href='{{ routes.all_products_collection_url }}' class='underlined-link'>
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>

    <div class='cart__warnings smcp-empty'>
      {%- render 'sm-cart-empty' -%}
      <p class='smc-trust'><span>Gratisversand ab {% render 'sm-fakt', key: 'gratisversand_ab' %}</span><span>100 % Gl&uuml;cksgarantie</span><span>4,82 &#9733; Trusted Shops</span></p>
    </div>

    <form action='{{ routes.cart_url }}' class='cart__contents critical-hidden' method='post' id='cart'>
      <div class='cart__items' id='main-cart-items' data-id='{{ section.id }}'>
        <div class='js-contents'>
          {%- if cart != empty -%}
            <div class='smcp'>
              <div class='smcp__main'>
                {%- render 'sm-rewards-panel' -%}
                <table class='cart-items'>
                  <caption class='visually-hidden'>{{ 'sections.cart.title' | t }}</caption>
                  <tbody>
                    {%- for item in cart.items -%}
                      {%- if item.variant_id == 45204915880202 or item.variant_id == 45204916535562 or item.variant_id == 45204919943434 -%}{%- continue -%}{%- endif -%}
                      {%- assign smc_addon = false -%}{%- if item.properties['_pc_pricing_ref'] != blank and item.properties.size == 1 -%}{%- assign smc_addon = true -%}{%- endif -%}
                      <tr class='cart-item{% if item.final_price == 0 %} cart-item--reward{% endif %}{% if smc_addon %} smc-addon{% endif %}' id='CartItem-{{ item.index | plus: 1 }}'>
                        <td class='cart-item__media'>
                          {%- if item.image -%}
                            <a href='{{ item.url }}' class='cart-item__link' aria-hidden='true' tabindex='-1'> </a>
                            <img class='cart-item__image' src='{{ item.image | image_url: width: 300 }}' alt='{{ item.image.alt | escape }}' loading='lazy' width='150' height='{{ 150 | divided_by: item.image.aspect_ratio | ceil }}'>
                          {%- endif -%}
                        </td>
                        <td class='cart-item__details'>
                          {%- render 'sm-cart-line-details', item: item -%}
                        </td>
                        <td class='cart-item__totals right'>
                          {%- render 'loading-spinner' -%}
                          <div class='cart-item__price-wrapper'>
                            {%- if item.original_line_price != item.final_line_price -%}
                              <s class='cart-item__old-price price price--end'>{{ item.original_line_price | money_without_currency }} €</s>
                              <span class='price price--end'>{{ item.final_line_price | money_without_currency }} €</span>
                            {%- else -%}
                              <span class='price price--end'>{{ item.original_line_price | money_without_currency }} €</span>
                            {%- endif -%}
                          </div>
                          <cart-remove-button id='Remove-{{ item.index | plus: 1 }}' data-index='{{ item.index | plus: 1 }}'>
                            <button type='button' class='button button--tertiary cart-remove-button' aria-label='{{ 'sections.cart.remove_title' | t: title: item.title | escape }}' data-variant-id='{{ item.variant.id }}'>Entfernen</button>
                          </cart-remove-button>
                        </td>
                        <td class='cart-item__quantity'>
                          <div class='cart-item__error' id='Line-item-error-{{ item.index | plus: 1 }}' role='alert'>
                            <small class='cart-item__error-text'></small>
                            <span class='svg-wrapper'>{{- 'icon-error.svg' | inline_asset_content -}}</span>
                          </div>
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
                {%- render 'sm-cart-extras', page: true -%}
              </div>
              <aside class='smcp__side'>
                <div class='smcp__card'>
                  <div class='smc-sum'>{%- render 'sm-cart-summary' -%}</div>
                  <button type='submit' id='smc-checkout' class='cart__checkout-button button smc-checkout' name='checkout'>Zur Kasse <span aria-hidden='true'>&rarr;</span></button>
                  {%- if additional_checkout_buttons -%}
                    <div class='cart__dynamic-checkout-buttons additional-checkout-buttons smc-express'>{{ content_for_additional_checkout_buttons }}</div>
                  {%- endif -%}
                  <p class='smc-trust'><span>4,82 &#9733; &bdquo;Hervorragend&ldquo; bei Trusted Shops</span><span>100 % Gl&uuml;cksgarantie</span></p>
                </div>
              </aside>
            </div>
          {%- endif -%}
        </div>
      </div>

      <p class='visually-hidden' id='cart-live-region-text' aria-live='polite' role='status'></p>
      <p
        class='visually-hidden'
        id='shopping-cart-line-item-status'
        aria-live='polite'
        aria-hidden='true'
        role='status'
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
