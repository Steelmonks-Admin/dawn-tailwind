{%- comment -%}
  Steelmonks-Footer: gleiche Einstellungen und Blöcke wie der Dawn-Footer (footer.liquid bleibt als Rückfall),
  neues Layout mit Newsletter-Karte (Klaviyo-Liste, Pixel-Art Jakob) und drei Menü-Karten.
{%- endcomment -%}
{{ 'sm-footer.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign has_social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign has_social_icons = false
  endif
-%}
<footer class="smf color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="smf-wrap page-width">
    <div class="smf-top">
      <div class="smf-brand">
        {%- for block in section.blocks -%}
          {%- if block.type == 'text' -%}
            <div class="smf-text" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <a href="{{ routes.root_url }}" class="smf-logo" aria-label="{{ shop.name | escape }}">
                  <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ shop.name | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                </a>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}<h2 class="smf-h">{{ block.settings.heading }}</h2>{%- endif -%}
              <div class="smf-rte">{{ block.settings.subtext }}</div>
            </div>
          {%- elsif block.type == '@app' -%}
            {% render block %}
          {%- endif -%}
        {%- endfor -%}
        <div class="smf-follow">
          {%- if section.settings.show_social and has_social_icons -%}
            {%- render 'social-icons', class: 'smf-social' -%}
          {%- endif -%}
          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="smf-shop">{{ shop | login_button: action: 'follow' }}</div>
          {%- endif -%}
        </div>
      </div>

      <div class="smf-nl">
        <span class="smf-px" aria-hidden="true">
          <img src="{{ 'sm-px3_jakob_letter.webp' | asset_url }}" alt="" width="120" height="212" loading="lazy">
          <i></i><i></i><i></i>
        </span>
        <div class="smf-nl-body">
          <p class="smf-eyebrow">Newsletter</p>
          <h2 class="smf-nl-h">5&nbsp;€ Willkommens&shy;geschenk</h2>
          <p class="smf-nl-p">Neuheiten, Aktionen und Geschichten aus der Werkstatt – dazu 5&nbsp;€ für Deine erste Bestellung.</p>
          <form class="smf-form" id="smfForm" data-company="{{ section.settings.sm_klaviyo_company | escape }}" data-list="{{ section.settings.sm_klaviyo_list | escape }}" novalidate>
            <label class="visually-hidden" for="smfMail">E-Mail-Adresse</label>
            <input id="smfMail" type="email" name="email" autocomplete="email" inputmode="email" placeholder="Deine E-Mail-Adresse" required>
            <button type="submit">Anmelden</button>
          </form>
          <p class="smf-msg" id="smfMsg" role="status" aria-live="polite"></p>
          <p class="smf-legal">Abmelden kannst Du Dich jederzeit. <a href="/pages/datenschutzerklarung">Datenschutz</a></p>
        </div>
      </div>
    </div>

    <div class="smf-cols">
      {%- assign n = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' and block.settings.menu != blank -%}
          {%- assign n = n | plus: 1 -%}
          <details class="smf-col" {{ block.shopify_attributes }}>
            <summary>
              <span class="smf-ic" aria-hidden="true">
                {%- case n -%}
                  {%- when 1 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
                  {%- when 2 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M5 7h14M7 7l-3 7a3 3 0 0 0 6 0L7 7ZM17 7l-3 7a3 3 0 0 0 6 0l-3-7ZM8 21h8"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5Z"/><path d="M4 19a2 2 0 0 1 2-2h13M9 7h6"/></svg>
                {%- endcase -%}
              </span>
              <span class="smf-col-h">{{ block.settings.heading | default: block.settings.menu.title }}</span>
              <svg class="smf-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <ul class="smf-list" role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}><span>{{ link.title | escape }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></li>
              {%- endfor -%}
            </ul>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="smf-bottom">
      <div class="smf-loc">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      {%- if section.settings.payment_enable -%}
        <div class="smf-pay">
          <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
          <ul class="list list-payment" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
    <div class="smf-copy">
      <small>Copyright &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}</small>
      {%- if section.settings.show_policy -%}
        <ul class="smf-pol list-unstyled">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<li><small><a href="{{ policy.url }}">{{ policy.title | escape }}</a></small></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  (function(){
    var mq = window.matchMedia('(min-width: 750px)');
    function sync(){ document.querySelectorAll('.smf-col').forEach(function(d){ d.open = mq.matches; }); }
    sync(); mq.addEventListener ? mq.addEventListener('change', sync) : mq.addListener(sync);
    var f = document.getElementById('smfForm'); if (!f) return;
    var msg = document.getElementById('smfMsg'), btn = f.querySelector('button'), input = f.querySelector('input');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ msg.textContent = 'Bitte gib eine gültige E-Mail-Adresse ein.'; msg.className = 'smf-msg err'; input.focus(); return; }
      btn.disabled = true; btn.textContent = '…';
      fetch('https://a.klaviyo.com/client/subscriptions?company_id=' + encodeURIComponent(f.dataset.company), {
        method: 'POST', headers: { 'Content-Type': 'application/vnd.api+json', 'revision': '2025-01-15' },
        body: JSON.stringify({ data: { type: 'subscription', attributes: { custom_source: 'Footer', profile: { data: { type: 'profile', attributes: { email: email } } } }, relationships: { list: { data: { type: 'list', id: f.dataset.list } } } } })
      }).then(function(r){
        if (!r.ok) throw new Error(r.status);
        f.hidden = true; msg.textContent = 'Danke! Schau gleich in Dein Postfach – dort wartet Dein 5-€-Gutschein.'; msg.className = 'smf-msg ok';
        try { (window.dataLayer = window.dataLayer || []).push({ event: 'newsletter_footer' }); } catch(x){}
      }).catch(function(){
        btn.disabled = false; btn.textContent = 'Anmelden'; msg.textContent = 'Das hat leider nicht geklappt. Bitte versuch es noch einmal.'; msg.className = 'smf-msg err';
      });
    });
  })();
</script>

