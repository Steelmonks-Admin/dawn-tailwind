{% if cart == empty %}
  <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
{% else %}
  <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
{% endif %}

<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- capture smr_count -%}{%- render 'sm-cart-count' -%}{%- endcapture -%}
{%- assign smr_count = smr_count | strip | plus: 0 -%}
{%- if smr_count > 0 -%}
  <div class="cart-count-bubble">
    {%- if smr_count < 100 -%}
      <span aria-hidden="true">{{ smr_count }}</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: smr_count }}</span>
  </div>
{%- endif -%}
