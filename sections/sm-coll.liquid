{%- comment -%}
  Neue Kollektionsseite wie im Prototyp (#hausschilder): Kopf mit Kennzahlen und Tipp, Untergruppen nach Produkttyp,
  Sortierung nach echten Bestellungen, Preis-Regler, „ab 4,8 ★“, Top 3, „Weitere anzeigen“. Ohne Suchfeld.
  Alle Produkte einer Seite (bis 250) kommen serverseitig als Karten, sortiert nach dem Metafeld steelmonks.bestellungen
  (dann Anzahl Bewertungen, dann Reihenfolge der Kollektion): Schlüssel aus Bestellungen+10^8, Bewertungen+10^6 und 9999-Position
  als Text sortieren, umdrehen, Position zurückrechnen. sm-coll.js filtert und sortiert danach im Browser ohne Neuladen.
  Nicht gezeigt: Meilensteine, versteckte Personalisierungs-Produkte, Befestigungssets, Versand, „zusätzlich“, Gravur-Zusätze, Preis 0.
  Steht die Kollektion in „schild_bei“ oder „nummer_bei“, kommt über der Liste die Schilder-Werkstatt (snippets/sm-coll-schild.liquid):
  bei „schild_bei“ fragt sie zuerst nach Straße oder Wunschtext, bei „nummer_bei“ zuerst nach der Hausnummer.
  Auf diesen Seiten ist die Werkstatt das eine Bedienelement: Kategorie (statt der Reiter), Sortierung und Filter stehen als kompakte Auswahl darin,
  die Filterleiste darunter entfällt, und der Kopf zeigt keinen Tipp (der Mönch spricht nur in der Werkstatt).
  Alle anderen Kollektionen behalten Filterleiste und Tipp, der Tipp aber ruhig: eine Zeile unter der Vertrauenszeile, ohne Mönch und Blase,
  ohne Prozente (Sätze des Metafelds mit „%“ fallen weg) und ohne Stückzahl beim meistbestellten Produkt. Die Sortierung dort ist eine helle Auswahlliste
  wie in der Werkstatt (Knopf mit Mono-Beschriftung, Liste aus sm-coll.js), nicht mehr das select des Browsers; das select bleibt versteckt als Quelle.
  Werkstatt-Seiten tragen am Rahmen die Klasse sms-werk (Karten halten dort am Handy eine Zeile für die Größe unter dem Preis frei).
  Kategorien: gehen die gezeigten Gruppen nicht in „Alle“ auf (Typen mit nur einem Produkt, mehr als fünf Gruppen), kommt „Weitere“ mit dem Rest dazu.
{%- endcomment -%}
{{ 'sm-home.css' | asset_url | stylesheet_tag }}
{{ 'sm-coll.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .smh .c-notiz{position:relative;max-width:72ch;margin-top:10px;padding-left:14px;font-size:13.44px;line-height:1.5;color:var(--ink-2)}
  .smh .c-notiz::before{content:"";position:absolute;left:0;top:.56em;width:6px;height:6px;border-radius:50%;background:var(--laser)}
  .smh .c-notiz b,.smh .c-notiz a:not(.tlink){color:var(--ink);font-weight:600}
  .smh .c-notiz .tlink{font-size:inherit;color:var(--ink-2)}
  @media (max-width: 760px){.smh .c-notiz{font-size:12.8px;margin-top:8px}}
  .smh .smc-dd{position:relative;flex:none}
  .smh .smc-k{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 14px 0 16px;border-radius:999px;border:1px solid var(--line-l);background:var(--white);color:var(--ink);font:inherit;font-size:13.44px;font-weight:600;white-space:nowrap;cursor:pointer}
  .smh .smc-k:hover,.smh .smc-k[aria-expanded="true"]{border-color:var(--ink)}
  .smh .smc-k::after{content:"";flex:none;width:6px;height:6px;margin:-3px 0 0 2px;border-right:1.5px solid var(--ink-2);border-bottom:1.5px solid var(--ink-2);transform:rotate(45deg);transition:transform .15s}
  .smh .smc-k[aria-expanded="true"]::after{transform:rotate(225deg);margin-top:3px}
  .smh .smc-k-l{font-family:var(--f-mono);font-size:9.92px;font-weight:400;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-2)}
  .smh .smc-dd-l{position:absolute;right:0;top:calc(100% + 6px);z-index:40;min-width:230px;margin:0;padding:6px;list-style:none;border-radius:14px;background:var(--white);box-shadow:0 0 0 1px var(--line-l),0 24px 48px -16px rgba(0,0,0,.35)}
  .smh .smc-dd-l[hidden]{display:none}
  .smh .smc-dd-l:focus{outline:0}
  .smh .smc-dd-l li{position:relative;display:flex;align-items:center;min-height:44px;padding:0 40px 0 12px;border-radius:10px;font-size:14.4px;color:var(--ink);cursor:pointer;-webkit-user-select:none;user-select:none}
  .smh .smc-dd-l li:hover{background:rgba(11,12,14,.05)}
  .smh .smc-dd-l li:focus-visible{outline:2px solid var(--blau);outline-offset:-2px}
  .smh .smc-dd-l li[aria-selected="true"]{font-weight:600;background:rgba(11,12,14,.04)}
  .smh .smc-dd-l li[aria-selected="true"]::after{content:"";position:absolute;right:16px;top:50%;width:11px;height:6px;margin-top:-5px;border-left:2px solid var(--warn);border-bottom:2px solid var(--warn);transform:rotate(-45deg)}
  @media (max-width: 760px){
    .smh .fbar .smc-dd{flex:1;min-width:0}
    .smh .smc-k{width:100%;min-height:44px}
    .smh .smc-k-v{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;text-align:left}
    .smh .smc-dd-l{left:0;right:auto;min-width:min(260px,calc(100vw - 32px))}
  }
  @media (prefers-reduced-motion: reduce){.smh .smc-k::after{transition:none}}
{%- endstyle -%}
<script src="{{ 'sm-home.js' | asset_url }}" defer></script>
<script src="{{ 'sm-coll.js' | asset_url }}" defer></script>
{%- liquid
  assign smc_ex = ',Meilenstein,PPLR_HIDDEN_PRODUCT,Befestigungsset,Versand,'
  assign smc_arr = '<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>'
-%}
{%- assign smc_skip = section.settings.ausblenden_bei | remove: ' ' | prepend: ',' | append: ',' -%}{%- assign smc_hh = ',' | append: collection.handle | append: ',' -%}
{%- unless smc_skip contains smc_hh -%}
{%- paginate collection.products by 250 -%}
{%- liquid
  assign smc_keys = ''
  assign smc_types = 'x'
  assign smc_sum = 0
  assign smc_cnt = 0
  assign smc_maxp = 0
  for p in collection.products
    assign t = ',' | append: p.type | append: ','
    if smc_ex contains t or p.handle contains 'zusaetzlich' or p.handle contains 'zusatzlich' or p.handle contains 'gravur' or p.price == 0
      continue
    endif
    assign o = p.metafields.steelmonks.bestellungen.value | default: 0
    assign rn = p.metafields.reviews.rating_count.value | default: 0
    assign smc_rank = o
    if collection.handle == 'neuheiten'
      assign smc_rank = p.created_at | date: '%s' | divided_by: 86400
    endif
    assign k = smc_rank | plus: 100000000 | append: ''
    assign k2 = rn | plus: 1000000 | append: ''
    assign k3 = 9999 | minus: forloop.index0 | append: ''
    assign smc_keys = smc_keys | append: k | append: k2 | append: k3 | append: '|'
    assign smc_sum = smc_sum | plus: o
    assign smc_cnt = smc_cnt | plus: 1
    if p.price_min > smc_maxp
      assign smc_maxp = p.price_min
    endif
    assign smc_types = smc_types | append: '|' | append: p.type | append: '|'
  endfor
  assign smc_sorted = smc_keys | split: '|' | sort | reverse
  assign smc_types = smc_types | append: 'x'

  comment
    Untergruppen: Produkttypen mit mindestens 2 Produkten, die größten fünf, Rest unter „Weitere“; nur wenn es mindestens zwei Gruppen gibt
  endcomment
  assign smc_tlist = ''
  assign smc_uniq = smc_types | remove_first: 'x|' | remove_last: '|x' | split: '||' | uniq
  for ty in smc_uniq
    if ty == blank
      continue
    endif
    assign probe = '|' | append: ty | append: '|'
    assign c = smc_types | split: probe | size | minus: 1
    if c >= 2
      assign pad = c | plus: 10000 | append: ''
      assign smc_tlist = smc_tlist | append: pad | append: '~' | append: ty | append: '^'
    endif
  endfor
  assign smc_tsorted = smc_tlist | split: '^' | sort | reverse
  assign smc_show_tabs = false
  if smc_tsorted.size >= 2
    assign smc_show_tabs = true
  endif
  assign smc_rest = smc_cnt
  for row in smc_tsorted limit: 5
    assign c = row | split: '~' | first | minus: 10000
    assign smc_rest = smc_rest | minus: c
  endfor

  comment
    Gemeinsames Präfix wie „Feuerwehr-“ oder „Zunft-“ in den Reitern weglassen, wenn alle gezeigten Typen es tragen
  endcomment
  assign smc_pre = ''
  if smc_show_tabs
    assign first = smc_tsorted.first | split: '~' | last
    if first contains '-'
      assign smc_pre = first | split: '-' | first | append: '-'
      for row in smc_tsorted limit: 5
        assign ty = row | split: '~' | last
        assign head = ty | slice: 0, smc_pre.size
        if head != smc_pre or ty.size <= smc_pre.size
          assign smc_pre = ''
          break
        endif
      endfor
    endif
  endif

  assign smc_sum_r = smc_sum
  if smc_sum >= 1000
    assign smc_sum_r = smc_sum | divided_by: 100 | times: 100
  elsif smc_sum >= 100
    assign smc_sum_r = smc_sum | divided_by: 10 | times: 10
  endif
  assign smc_maxe = smc_maxp | divided_by: 1000 | plus: 1 | times: 10
  assign smc_sch = section.settings.schild_bei | remove: ' ' | prepend: ',' | append: ','
  assign smc_nrb = section.settings.nummer_bei | remove: ' ' | prepend: ',' | append: ','
  assign smc_werk = ''
  if smc_nrb contains smc_hh
    assign smc_werk = 'nummer'
  elsif smc_sch contains smc_hh
    assign smc_werk = 'strasse'
  endif
  assign smc_lead = collection.metafields.steelmonks.kurztext.value | default: section.settings.lead
  if smc_lead == blank
    assign smc_lead = collection.description | strip_html | truncatewords: 24, '…'
  endif
-%}
<div class="smh smc{% if smc_werk != '' %} sms-werk{% endif %}" data-smc{% if collection.handle == 'neuheiten' %} data-default-sort='new'{% endif %} data-step="{{ section.settings.erste }}">
  <section class="c-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Brotkrumen"><a href="/">Startseite</a> / <span>{{ collection.title | escape }}</span></nav>
      <div class="c-top">
        <div>
          <h1 class="display">{{ collection.title | escape }}</h1>
          {%- if smc_lead != blank -%}<p class="lead">{{ smc_lead }}</p>{%- endif -%}
          <div class="c-proof"><span><span class="stars">★</span> <b data-ts-rating>{{ section.settings.ts_note }}</b> bei Trusted Shops</span>{% if smc_sum >= 100 %}<span><b>{% render 'sm-num', n: smc_sum_r %}+</b> Bestellungen seit 2020</span>{% endif %}<span class="ship">Gratisversand ab 99 €</span><span class="count">{{ smc_cnt }} {% if smc_cnt == 1 %}Produkt{% else %}Produkte{% endif %}</span></div>
          {%- liquid
            assign smc_tip_html = ''
            if section.settings.tipp_zeigen and smc_werk == ''
              assign smc_tip = collection.metafields.steelmonks.tipp.value | default: ''
              if smc_tip != blank
                assign smc_saetze = smc_tip | strip | replace: '. ', '.~' | split: '~'
                for satz in smc_saetze
                  unless satz contains '%'
                    assign smc_tip_html = smc_tip_html | append: satz | append: ' '
                  endunless
                endfor
                assign smc_tip_html = smc_tip_html | strip
              elsif smc_sorted.size > 0
                assign k = smc_sorted.first
                assign ix = k | slice: 16, 4 | plus: 0
                assign ix = 9999 | minus: ix
                assign smc_top = collection.products[ix]
                if smc_top.metafields.steelmonks.bestellungen.value > 99
                  capture smc_tip_html
                    echo 'Am häufigsten bestellt: <b>'
                    echo smc_top.title | escape
                    echo '</b>. <a class="tlink" href="'
                    echo smc_top.url
                    echo '">Ansehen</a>'
                  endcapture
                endif
              endif
            endif
          -%}
          {%- if smc_tip_html != blank -%}<p class="c-notiz">{{ smc_tip_html }}</p>{%- endif -%}
        </div>

      </div>
      {%- if smc_werk != '' -%}
        {%- capture smc_kat_html -%}
          {%- if smc_show_tabs -%}<li role="option" data-tab="*" aria-selected="true" tabindex="-1"><span>Alle</span><small>{{ smc_cnt }}</small></li>
          {%- for row in smc_tsorted limit: 5 -%}{%- assign parts = row | split: '~' -%}{%- assign c = parts[0] | minus: 10000 -%}
          <li role="option" data-tab="{{ parts[1] | escape }}" aria-selected="false" tabindex="-1"><span>{% if smc_pre != '' %}{{ parts[1] | remove_first: smc_pre | escape }}{% else %}{{ parts[1] | escape }}{% endif %}</span><small>{{ c }}</small></li>
          {%- endfor -%}
          {%- if smc_rest > 0 -%}<li role="option" data-tab="~weitere" aria-selected="false" tabindex="-1"><span>Weitere</span><small>{{ smc_rest }}</small></li>{%- endif -%}{%- endif -%}
        {%- endcapture -%}
        {%- capture smc_sort_opts -%}{% if collection.handle == "neuheiten" %}<option value="new" selected>Neueste zuerst</option>{% endif %}<option value="pop">Beliebteste zuerst</option><option value="rating">Beste Bewertung</option><option value="reviews">Meiste Bewertungen</option><option value="asc">Preis aufsteigend</option><option value="desc">Preis absteigend</option>{%- endcapture -%}
        {%- capture smc_anz -%}{{ smc_cnt }} {% if smc_cnt == 1 %}Produkt{% else %}Produkte{% endif %}{%- endcapture -%}
        {% render 'sm-coll-schild', collection: collection, sms_modus: smc_werk, sms_kat: smc_kat_html, sms_sort: smc_sort_opts, sms_anz: smc_anz, sms_maxe: smc_maxe, sms_id: section.id %}
      {%- endif -%}


      <div class="c-list">
        {%- if smc_werk == '' -%}
        <div class="fbar">
          <div class="grp scroll" role="group" aria-label="Art">
            {%- if smc_show_tabs -%}<button type="button" data-tab="*" aria-pressed="true">Alle<small>{{ smc_cnt }}</small></button>
        {%- for row in smc_tsorted limit: 5 -%}{%- assign parts = row | split: '~' -%}{%- assign c = parts[0] | minus: 10000 -%}
        <button type="button" data-tab="{{ parts[1] | escape }}" aria-pressed="false">{% if smc_pre != '' %}{{ parts[1] | remove_first: smc_pre | escape }}{% else %}{{ parts[1] | escape }}{% endif %}<small>{{ c }}</small></button>
        {%- endfor -%}
        {%- if smc_rest > 0 -%}<button type="button" data-tab="~weitere" aria-pressed="false">Weitere<small>{{ smc_rest }}</small></button>{%- endif -%}{%- else -%}<span class="count">{{ smc_cnt }} {% if smc_cnt == 1 %}Produkt{% else %}Produkte{% endif %}</span>{%- endif -%}
          </div>
          <div class="grp">
            <div class="smc-dd"><button class="smc-k" type="button" data-sortk aria-haspopup="listbox" aria-expanded="false" aria-controls="smcSortL-{{ section.id }}"><span class="smc-k-l">Sortieren</span><span class="smc-k-v" data-sortv>Beliebteste</span></button></div>
            <select id="smcSort-{{ section.id }}" data-sort hidden aria-label="Sortieren">{% if collection.handle == "neuheiten" %}<option value="new" selected>Neueste zuerst</option>{% endif %}<option value="pop">Beliebteste zuerst</option><option value="rating">Beste Bewertung</option><option value="reviews">Meiste Bewertungen</option><option value="asc">Preis aufsteigend</option><option value="desc">Preis absteigend</option></select>
            <button class="btn btn-g btn-s more" type="button" data-fmore aria-expanded="false" aria-controls="smcPanel-{{ section.id }}">Filter</button></div>
        </div>
        <div class="fpanel" id="smcPanel-{{ section.id }}" hidden>
          <label for="smcMax-{{ section.id }}" data-maxt>Alle Preise</label><input type="range" id="smcMax-{{ section.id }}" data-max min="10" max="{{ smc_maxe }}" step="5" value="{{ smc_maxe }}">
          <label class="chip"><input type="checkbox" data-top> ab 4,8 ★</label>
          <span class="count" data-hits></span>
        </div>
        {%- endif -%}

        <div class="cgrid" data-grid>
          {%- for k in smc_sorted -%}{%- assign ix = k | slice: 16, 4 | plus: 0 -%}{%- assign ix = 9999 | minus: ix -%}{%- assign p = collection.products[ix] -%}
            {%- liquid
              assign o = p.metafields.steelmonks.bestellungen.value | default: 0
              assign rn = p.metafields.reviews.rating_count.value | default: 0
              assign rr = p.metafields.reviews.rating.value.rating | default: 0 | times: 100 | round
              assign smc_abz = ''
              if forloop.index <= 3 and o > 0
                assign smc_abz = '<span class="badge hot">Top ' | append: forloop.index | append: '</span>'
              endif
            -%}
            <div class="cc" data-h="{{ p.handle }}" data-type="{{ p.type | escape }}" data-p="{{ p.price_min }}" data-r="{{ rr }}" data-n="{{ rn }}" data-o="{{ o }}" data-i="{{ forloop.index0 }}"{% if forloop.index > section.settings.erste %} hidden{% endif %}>{% render 'sm-home-card', product: p, smk_abzeichen: smc_abz %}</div>
          {%- endfor -%}
          <div class="empty-res" data-empty hidden><img src="{{ 'sm-px3_monk_shrug.webp' | asset_url }}" alt="Pixel-Art: der Mönch zuckt mit den Schultern" width="110" height="131" loading="lazy"><p><b>Keine Treffer.</b> Lockere die Filter, zum Beispiel den Preis oder „ab 4,8 ★“.</p></div>
        </div>
        <div class="more-row"{% if smc_cnt <= section.settings.erste %} hidden{% endif %} data-morerow><button class="btn btn-i" type="button" data-more>Weitere {{ smc_cnt | minus: section.settings.erste }} anzeigen {{ smc_arr }}</button></div>
        {%- if paginate.next -%}<div class="more-row"><a class="btn btn-g" href="{{ paginate.next.url }}">Nächste Seite {{ smc_arr }}</a></div>{%- endif -%}
      </div>

      {%- if section.settings.text_zeigen and collection.description != blank -%}
      <div class="c-seo">
        <div class="rte">{{ collection.description }}</div>
      </div>
      {%- endif -%}
    </div>
  </section>
</div>
{%- endpaginate -%}
{%- endunless -%}

{% schema %}
{
  "name": "SM Kollektion",
  "tag": "section",
  "class": "section smh-section",
  "settings": [
    { "type": "range", "id": "erste", "label": "Zuerst sichtbare Produkte", "min": 8, "max": 32, "step": 4, "default": 16 },
    { "type": "text", "id": "ts_note", "label": "Trusted-Shops-Note (Platzhalter, wird live aktualisiert)", "default": "4,83" },
    { "type": "text", "id": "lead", "label": "Einleitung, falls die Kollektion kein Metafeld steelmonks.kurztext hat", "info": "Ohne beides: der Anfang der Kollektionsbeschreibung" },
    { "type": "checkbox", "id": "tipp_zeigen", "label": "Tipp mit Pixel-Figur zeigen", "info": "Text aus dem Kollektions-Metafeld steelmonks.tipp, sonst das meistbestellte Produkt", "default": true },
    { "type": "select", "id": "pixel", "label": "Pixel-Figur", "default": "px3_monk_search.webp", "options": [
      { "value": "px3_monk_search.webp", "label": "Mönch mit Lupe" },
      { "value": "px_jakob_zeigt.webp", "label": "Jakob zeigt" },
      { "value": "px3_luis_ladder.webp", "label": "Luis auf der Leiter" },
      { "value": "px3_jakob_trophy.webp", "label": "Jakob mit Pokal" },
      { "value": "px2_luis_zunft.webp", "label": "Luis mit Zunftschild" },
      { "value": "px4_monk_curator.webp", "label": "Mönch als Kurator" }
    ] },
    { "type": "checkbox", "id": "text_zeigen", "label": "Kollektionsbeschreibung unten zeigen", "default": true },
    { "type": "text", "id": "ausblenden_bei", "label": "Nicht zeigen bei diesen Kollektionen (Handles, kommagetrennt)", "info": "Z. B. beliebt, wenn dieselbe Vorlage dort die Beliebt-Seite zeigt" },
    { "type": "text", "id": "schild_bei", "label": "Schilder-Werkstatt (Straße zuerst) bei diesen Kollektionen", "default": "strassenschilder,hausschilder", "info": "Handles, kommagetrennt. Besucher geben Straße oder Wunschtext und die Hausnummer ein und sehen jedes Schild mit ihrem Text neben einer Haustür." },
    { "type": "text", "id": "nummer_bei", "label": "Schilder-Werkstatt (Hausnummer zuerst) bei diesen Kollektionen", "default": "hausnummern", "info": "Handles, kommagetrennt. Erstes Feld ist die Hausnummer, Name oder Straße sind freiwillig. Steht eine Kollektion in beiden Feldern, gilt dieses." }
  ],
  "presets": [ { "name": "SM Kollektion" } ]
}
{% endschema %}
