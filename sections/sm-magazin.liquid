{%- comment -%}
  Steelmonks Magazin & Ratgeber: Blog-Übersicht mit Themen-Tags, Suche, optionaler Serie und Produkt-Kacheln (aus dem Prototyp).
  Eine Sektion für alle Blogs; Texte, Themen und Kacheln kommen aus den Einstellungen des jeweiligen Templates (blog.magazin.json, blog.ratgeber-*.json).
{%- endcomment -%}
<link rel="preload" href="{{ 'sm-bigshoulders-900.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
{{ 'sm-sonder.css' | asset_url | stylesheet_tag }}
{{ 'sm-magazin.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign S = section.settings
  assign topics = S.themen | split: ','
  assign cur = blank
  for t in current_tags
    if topics contains t
      assign cur = t
      break
    endif
  endfor
  if cur == blank and current_tags.size > 0
    assign cur = current_tags | first
  endif
  assign start = false
  assign story = section.blocks | where: 'type', 'story'
  assign name = S.name | default: blog.title
-%}
{%- paginate blog.articles by 17 -%}
{%- liquid
  if cur == blank and paginate.current_page == 1
    assign start = true
  endif
  # Produkt-Kachel: Thema → Vorlage laut „cta_themen“, auf Übersichtsseiten reihum laut „cta_zyklus“
  assign ctakey = ''
  if cur != blank
    assign ch = cur | handleize
    assign pairs = S.cta_themen | split: ','
    for pr in pairs
      assign kv = pr | split: '='
      if kv[0] == ch
        assign ctakey = kv[1]
      endif
    endfor
  endif
  if ctakey == ''
    assign cyc = S.cta_zyklus | split: ','
    assign ci = paginate.current_page | minus: 1 | modulo: cyc.size
    assign ctakey = cyc[ci]
  endif
  # Pixel-Figur für Themenseiten
  assign tpx = S.px
  if cur != blank
    assign pairs = S.px_themen | split: ','
    for pr in pairs
      assign kv = pr | split: '='
      if kv[0] == ch
        assign tpx = kv[1]
      endif
    endfor
  endif
-%}
<div class="smx" data-mag data-section="{{ section.id }}" data-kurz="{{ S.kurz }}" data-topics='{{ topics | json | escape }}'>
  <div class="sa-hero bl-hero dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Brotkrumen" style="color:var(--steel)"><a href="{{ routes.root_url }}" style="color:inherit">Startseite</a> / {% if cur != blank or paginate.current_page > 1 %}<a href="{{ blog.url }}" style="color:inherit">{{ name | escape }}</a>{% if cur != blank %} / <span>{{ cur | escape }}</span>{% endif %}{% else %}<span>{{ name | escape }}</span>{% endif %}</nav>
      {%- capture search -%}
        <form class="bl-search" id="blSearch" role="search" action="{{ routes.search_url }}" method="get"><input type="hidden" name="type" value="article"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><label class="sr-only" for="blQ">Artikel durchsuchen</label><input id="blQ" name="q" type="search" placeholder="{{ S.suche | escape }}" autocomplete="off"><button class="btn btn-p btn-s" type="submit">Suchen</button></form>
      {%- endcapture -%}
      {%- capture h1 -%}{{ S.titel | escape }}{% if S.titel_hl != blank %} <span class="hl">{{ S.titel_hl | escape }}</span>{% endif %}{%- endcapture -%}
      {%- if start -%}
        {%- liquid
          assign fk = blog.handle | append: '/' | append: S.featured
          assign F = articles[fk]
          if F == blank or F.title == blank
            assign F = blog.articles.first
          endif
          assign ftopic = ''
          for t in F.tags
            if topics contains t
              assign ftopic = t
              break
            endif
          endfor
          assign fw = F.content | strip_html | split: ' ' | size | divided_by: 200
          if fw < 2
            assign fw = 2
          endif
        -%}
        <div class="bl-top">
          <div>
            <p class="eyebrow" style="margin-top:14px">{{ S.eyebrow | escape }}</p>
            <h1 class="sa-h1">{{ h1 }}</h1>
            <p class="sa-lead">{{ S.lead | escape }}</p>
            {{ search }}
            <div class="bl-stats"><div><b>{{ blog.articles_count }}</b><span>Artikel</span></div><div><b>{{ topics.size }}</b><span>Themen</span></div>{% if story.size > 0 %}<div><b>{{ story.size }}</b><span>{{ S.story_stat | escape }}</span></div>{% elsif S.stat_zahl != blank %}<div><b>{{ S.stat_zahl | escape }}</b><span>{{ S.stat_text | escape }}</span></div>{% endif %}</div>
          </div>
          <div class="bl-feat-wrap" data-rv>
            <a class="bl-feat" href="{{ F.url }}">
              <span class="im">{% if F.image %}{{ F.image | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '560, 820, 1100', sizes: '(max-width: 980px) 92vw, 540px', alt: '' }}{% endif %}</span>
              <span class="tag">Empfohlen</span>
              <span class="bd">{% if ftopic != '' %}<span class="eyebrow" style="color:var(--blau-hell)">{{ ftopic | escape }}</span>{% endif %}<b>{% render 'sm-mag-title', title: F.title, kurz: S.kurz %}</b><span class="x">{{ F.excerpt | default: F.content | strip_html | truncatewords: 26, ' …' }}</span><span class="mt">{{ fw }} Min. Lesezeit<i>Weiterlesen →</i></span></span>
            </a>
            <span class="pxfx pxa-bob"><img src="{{ S.px_hero | asset_url }}" alt="" width="96" height="96"></span>
          </div>
        </div>
      {%- else -%}
        <div class="bl-top solo">
          <div>
            <p class="eyebrow" style="margin-top:14px">{% if cur != blank %}{{ name | escape }} · Thema{% else %}{{ S.eyebrow | escape }}{% endif %}</p>
            <h1 class="sa-h1">{% if cur != blank %}{{ cur | escape }}{% else %}{{ h1 }}{% endif %}{% if paginate.current_page > 1 %} <span class="hl" style="font-size:.5em">Seite {{ paginate.current_page }}</span>{% endif %}</h1>
            {{ search }}
          </div>
          <span class="pxfx pxa-sway"><img src="{{ tpx | asset_url }}" alt="" width="150" height="150"></span>
        </div>
      {%- endif -%}
      <nav class="bl-filter" aria-label="Themen">
        <a class="chip" href="{{ blog.url }}"{% if cur == blank %} aria-pressed="true" aria-current="page"{% endif %}>Alle Themen{% if cur == blank %} <small>{{ blog.articles_count }}</small>{% endif %}</a>
        {%- for t in topics -%}
          <a class="chip" href="{{ blog.url }}/tagged/{{ t | handleize }}"{% if cur == t %} aria-pressed="true" aria-current="page"{% endif %}>{{ t | escape }}</a>
        {%- endfor -%}
      </nav>
    </div>
  </div>
  <section class="sa-sec tight paper" id="blList" style="padding-top:clamp(28px,4vw,44px)"><div class="wrap">
    <div class="bl-status" id="blStatus" aria-live="polite">
      {%- if cur != blank -%}
        <span><b>{{ paginate.items }}</b> Artikel in {{ cur | escape }}</span><a href="{{ blog.url }}">Alle Themen ansehen</a>
      {%- else -%}
        <span><b>{{ paginate.items }}</b> Artikel{% if paginate.pages > 1 %} · Seite {{ paginate.current_page }} von {{ paginate.pages }}{% endif %}</span><span>Neueste zuerst</span>
      {%- endif -%}
    </div>
    <div class="bl-grid" id="blGrid">
      {%- for article in blog.articles -%}
        {%- render 'sm-mag-card', article: article, topics: topics, i: forloop.index0, kurz: S.kurz, px: S.px -%}
        {%- if forloop.index == 4 -%}{%- render 'sm-mag-cta', key: ctakey -%}{%- endif -%}
      {%- else -%}
        <div class="bl-empty"><img src="{{ 'sm-px3_monk_search.webp' | asset_url }}" alt=""><b>Dazu haben wir noch nichts geschrieben.</b><span class="muted">Frag uns einfach direkt – wir antworten innerhalb von zwei Werktagen.</span><a class="btn btn-p btn-s" href="/pages/kontakt">Frage stellen</a></div>
      {%- endfor -%}
    </div>
    <div class="bl-more">
      {%- if paginate.previous and paginate.next == blank %}<a class="btn btn-g" href="{{ paginate.previous.url }}">← Neuere Artikel</a>{% endif -%}
      {%- if paginate.next -%}<a class="btn btn-g" href="{{ paginate.next.url }}" id="blMore">Mehr Artikel laden</a>{%- endif -%}
    </div>
  </div></section>
  {%- if start and story.size > 0 -%}
  <section class="sa-sec sa-anth anth"><div class="wrap">
    <div class="sa-head" data-rv><div class="t"><span class="pxfx pxa-sway hide-m"><img src="{{ 'sm-px2_monk_pc.webp' | asset_url }}" alt="" width="112" height="112"></span><div><p class="eyebrow">Serie · {{ story.size }} Teile</p><h2 class="sa-h2">{{ S.story_titel | escape }}</h2><span class="sa-line"></span></div></div><div class="bl-nav"><button type="button" data-sn="-1" aria-label="Zurück">‹</button><button type="button" data-sn="1" aria-label="Weiter">›</button>{%- assign s1k = blog.handle | append: '/' | append: story.first.settings.handle -%}<a class="btn btn-p" href="{{ articles[s1k].url | default: blog.url }}">Mit Teil 1 beginnen</a></div></div>
    <p class="muted" style="max-width:62ch;margin:-8px 0 24px">{{ S.story_lead | escape }}</p>
    <div class="bl-story" id="blStory">
      {%- for block in story -%}
        {%- assign sk = blog.handle | append: '/' | append: block.settings.handle -%}
        {%- assign a = articles[sk] -%}
        {%- if a.title != blank -%}
          <a class="bl-part" href="{{ a.url }}" {{ block.shopify_attributes }}><span class="im">{% if a.image %}{{ a.image | image_url: width: 560 | image_tag: loading: 'lazy', widths: '280, 560', sizes: '(max-width: 620px) 78vw, 300px', alt: '' }}{% endif %}</span><span class="n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><b>{{ block.settings.titel | default: a.title | escape }}</b></a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div></section>
  {%- endif -%}
  <section class="sa-sec paper"><div class="wrap">
    <div class="sa-head" data-rv><div><p class="eyebrow">Noch mehr Wissen</p><h2 class="sa-h2">Unsere Ratgeber</h2><span class="sa-line"></span></div></div>
    <div class="bl-rub">
      {%- assign rub = 'steelmonks-de:sm-px3_monk_coffee.webp,nutzliches-fur-handwerker:sm-px2_luis_zunft.webp,nutzliches-fragen-und-antworten:sm-px3_monk_search.webp,nutzliches-fur-die-feuerwehr:sm-px3_jakob_fire.webp,nutzliches-interessantes-und-wissenswertes:sm-px4_monk_measure.webp,nutzliches-und-hilfreiches:sm-px3_luis_gift.webp' | split: ',' -%}
      {%- assign ri = 0 -%}
      {%- for r in rub -%}
        {%- assign rh = r | split: ':' | first -%}{%- assign rp = r | split: ':' | last -%}{%- assign rb = blogs[rh] -%}
        {%- if rb.title != blank and rb.handle != blog.handle -%}
          <a href="{{ rb.url }}" data-rv style="--d:{{ ri | times: 0.06 }}s"><img src="{{ rp | asset_url }}" alt="" width="54" height="54" loading="lazy"><i>{{ rb.articles_count }}</i><b>{% if rh == 'steelmonks-de' %}Steelmonks Magazin{% else %}{{ rb.title | escape }}{% endif %}</b><span>Artikel ansehen →</span></a>
          {%- assign ri = ri | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div></section>
  <section class="sa-sec sa-night dark"><div class="wrap">
    <div class="sa-head" data-rv><div class="t"><span class="pxfx pxa-bob hide-m"><img src="{{ 'sm-px2_monk_laser.webp' | asset_url }}" alt="" width="112" height="112"></span><div><p class="eyebrow">Vom Lesen zum Schild</p><h2 class="sa-h2">Lust bekommen?</h2><span class="sa-line"></span></div></div></div>
    <div class="sa-tiles">
      {%- assign kacheln = S.kacheln | split: ',' -%}
      {%- for kk in kacheln limit: 3 -%}{%- assign dd = forloop.index0 | times: 0.1 -%}{%- render 'sm-mag-cta', key: kk, stil: 'kachel', d: dd -%}{%- endfor -%}
    </div>
  </div></section>
</div>
{%- endpaginate -%}
<script src="{{ 'sm-magazin.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SM Magazin",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Kopf" },
    { "type": "text", "id": "name", "label": "Name in Brotkrumen", "default": "Magazin" },
    { "type": "text", "id": "eyebrow", "label": "Zeile über der Überschrift", "default": "Das Steelmonks Magazin" },
    { "type": "text", "id": "titel", "label": "Überschrift", "default": "Wissen aus der" },
    { "type": "text", "id": "titel_hl", "label": "Überschrift, blauer Teil", "default": "Werkstatt." },
    { "type": "textarea", "id": "lead", "label": "Einleitung", "default": "Zunftzeichen und Berufe, Wappen, Hausnummern und Geschenkideen – erklärt von den Leuten, die jeden Tag Stahl schneiden." },
    { "type": "text", "id": "suche", "label": "Suchfeld-Beispiel", "default": "Zum Beispiel: Zunftzeichen Elektriker" },
    { "type": "text", "id": "stat_zahl", "label": "Dritte Kennzahl (ohne Serie)" },
    { "type": "text", "id": "stat_text", "label": "Dritte Kennzahl, Text" },
    { "type": "text", "id": "px_hero", "label": "Pixel-Figur neben der Empfehlung (Asset)", "default": "sm-px3_monk_coffee.webp" },
    { "type": "text", "id": "px", "label": "Pixel-Figur für Themenseiten und Artikel ohne Bild (Asset)", "default": "sm-px3_monk_search.webp" },
    { "type": "text", "id": "px_themen", "label": "Pixel-Figur je Thema (thema-handle=asset, kommagetrennt)", "default": "feuerwehr-retter=sm-px3_jakob_fire.webp,wappen-heraldik=sm-px4_luis_wappen.webp,geschenkideen=sm-px3_luis_gift.webp,haus-garten=sm-px3_luis_ladder.webp,aus-der-werkstatt=sm-px2_monk_laser.webp,handwerk-zunft=sm-px2_luis_zunft.webp" },
    { "type": "header", "content": "Artikel" },
    { "type": "text", "id": "themen", "label": "Themen-Tags (kommagetrennt, ohne Leerzeichen nach dem Komma)", "default": "Handwerk & Zunft,Geschenkideen,Haus & Garten,Aus der Werkstatt,Feuerwehr & Retter,Wappen & Heraldik,Material & Wissen" },
    { "type": "text", "id": "featured", "label": "Empfohlener Artikel (Handle)", "default": "der-weg-zu-deinem-familienwappen" },
    { "type": "checkbox", "id": "kurz", "label": "Titel auf den Karten nur bis zum Fragezeichen", "default": false },
    { "type": "header", "content": "Produkt-Kacheln" },
    { "type": "paragraph", "content": "Vorlagen: zunftschild, signet, wappen, hausnummer, beliebt, werkstatt, handwerker, feuerwehr, paare, familie, motiv, firmenschild" },
    { "type": "text", "id": "cta_themen", "label": "Kachel je Thema (thema-handle=vorlage, kommagetrennt)", "default": "handwerk-zunft=zunftschild,feuerwehr-retter=signet,wappen-heraldik=wappen,haus-garten=hausnummer,geschenkideen=beliebt" },
    { "type": "text", "id": "cta_zyklus", "label": "Kacheln auf Übersichtsseiten, reihum je Seite", "default": "werkstatt,zunftschild,beliebt,wappen,hausnummer,signet" },
    { "type": "text", "id": "kacheln", "label": "Drei Kacheln unten", "default": "zunftschild,werkstatt,beliebt" },
    { "type": "header", "content": "Serie" },
    { "type": "text", "id": "story_titel", "label": "Überschrift", "default": "Die Steelmonks-Story" },
    { "type": "text", "id": "story_stat", "label": "Kennzahl-Text", "default": "Teile Steelmonks-Story" },
    { "type": "textarea", "id": "story_lead", "label": "Einleitung", "default": "Vom Traum zur Realität, vom Tauschgeschäft zur Manufaktur – wie Steelmonks entstanden ist, erzählt in zwölf Teilen." }
  ],
  "blocks": [
    { "type": "story", "name": "Serien-Teil", "settings": [
      { "type": "text", "id": "handle", "label": "Artikel-Handle" },
      { "type": "text", "id": "titel", "label": "Titel auf der Karte" } ] }
  ],
  "presets": [ { "name": "SM Magazin" } ]
}
{% endschema %}
