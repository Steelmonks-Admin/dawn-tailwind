<main class='twcss-flex twcss-flex-col twcss-gap-12' style='padding: {{ section.settings.padding }}px;'>
  <h2 class='twcss-text-center twcss-text-4xl twcss-font-bold'>{{ section.settings.heading }}</h2>
  <p style='font-style: italic;' class='twcss-text-center twcss-text-lg'>{{ section.settings.subheading }}</p>
  <p class='twcss-text-lg'>{{ section.settings.description }}</p>

  <section class='twcss-grid twcss-gap-8 md:twcss-grid-cols-3 twcss-text-center twcss-px-8 twcss-py-12 twcss-bg-brandblack twcss-text-brandwhite'>
    {% for block in section.blocks %}
      <div
        style='background-color:rgba(229, 231, 235, 0.12); padding: 20px;'
        class='twcss-flex twcss-flex-col twcss-items-center twcss-gap-4'
      >
        {% if block.settings.icon != blank %}
          <img
            src='{{ block.settings.icon | image_url: width: 50 }}'
            alt='{{ block.settings.title | escape }}'
            width='50'
            height='50'
            class='twcss-mx-auto twcss-mb-2 twcss-object-contain'
            loading='lazy'
          >
        {% endif %}
        <h3 class='twcss-text-2xl twcss-font-bold twcss-text-brandwhite'>{{ block.settings.title }}</h3>
        <p class='twcss-text-base twcss-text-brandwhite'>{{ block.settings.description }}</p>
      </div>
    {% endfor %}
  </section>

  <section class='twcss-flex twcss-flex-col twcss-gap-4 twcss-p-4 md:twcss-p-10 twcss-rounded-lg' id='widerrufsformular'>
    <h3 class='twcss-text-2xl twcss-font-bold'>Widerrufsformular</h3>
    <p class='twcss-text-base'>Fülle das Formular aus, wenn Du einen Vertrag widerrufen möchtest. Wir bestätigen den Eingang per E-Mail.</p>
    {%- form 'contact', id: 'WiderrufForm', class: 'smk-widerruf twcss-flex twcss-flex-col twcss-gap-4' -%}
      {%- if form.posted_successfully? -%}
        <p class='form-status form-status-list form__message' tabindex='-1' autofocus role='status'>
          {% render 'icon-success' %} Dein Widerruf ist bei uns eingegangen. Du erhältst in Kürze eine Bestätigung per E-Mail.
        </p>
      {%- elsif form.errors -%}
        <p class='form__message' role='alert'>
          {% render 'icon-error' %} Bitte prüfe Deine E-Mail-Adresse: {{ form.errors.messages['email'] }}
        </p>
      {%- endif -%}
      <input type='hidden' name='contact[Formular]' value='Widerruf'>
      <div class='twcss-grid twcss-gap-4 md:twcss-grid-cols-2'>
        <div class='field'>
          <input class='field__input' type='text' id='Widerruf-name' name='contact[Name]' autocomplete='name' placeholder='Vor- und Nachname' required value='{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}'>
          <label class='field__label' for='Widerruf-name'>Vor- und Nachname <span aria-hidden='true'>*</span></label>
        </div>
        <div class='field'>
          <input class='field__input' type='email' id='Widerruf-email' name='contact[email]' autocomplete='email' spellcheck='false' autocapitalize='off' placeholder='E-Mail' required value='{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}' aria-required='true'>
          <label class='field__label' for='Widerruf-email'>E-Mail <span aria-hidden='true'>*</span></label>
        </div>
        <div class='field'>
          <input class='field__input' type='text' id='Widerruf-order' name='contact[Bestellnummer]' placeholder='Bestellnummer' required inputmode='numeric'>
          <label class='field__label' for='Widerruf-order'>Bestellnummer <span aria-hidden='true'>*</span></label>
        </div>
        <div class='field'>
          <input class='field__input' type='date' id='Widerruf-date' name='contact[Bestellt am]' placeholder='Bestellt am'>
          <label class='field__label' for='Widerruf-date'>Bestellt am</label>
        </div>
      </div>
      <div class='field'>
        <textarea class='text-area field__input' id='Widerruf-items' name='contact[Artikel]' rows='3' placeholder='Artikel' required></textarea>
        <label class='form__label field__label' for='Widerruf-items'>Welche Artikel möchtest Du widerrufen? <span aria-hidden='true'>*</span></label>
      </div>
      <div class='field'>
        <textarea class='text-area field__input' id='Widerruf-address' name='contact[Anschrift]' rows='3' placeholder='Anschrift' autocomplete='street-address'></textarea>
        <label class='form__label field__label' for='Widerruf-address'>Deine Anschrift</label>
      </div>
      <div class='field'>
        <textarea class='text-area field__input' id='Widerruf-body' name='contact[body]' rows='4' placeholder='Nachricht'></textarea>
        <label class='form__label field__label' for='Widerruf-body'>Nachricht (optional)</label>
      </div>
      <label class='twcss-flex twcss-items-start twcss-gap-3 twcss-text-base' for='Widerruf-confirm'>
        <input type='checkbox' id='Widerruf-confirm' name='contact[Erklärung]' value='Hiermit widerrufe ich den von mir abgeschlossenen Vertrag über den Kauf der genannten Waren.' required class='twcss-mt-1'>
        <span>Hiermit widerrufe ich den von mir abgeschlossenen Vertrag über den Kauf der oben genannten Waren. <span aria-hidden='true'>*</span></span>
      </label>
      <div>
        <button type='submit' class='button'>Widerruf absenden</button>
      </div>
    {%- endform -%}
  </section>

  <section class='twcss-flex twcss-flex-col twcss-p-10'>
    {{ section.settings.content }}
  </section>
</main>

{% schema %}
{
  "name": "Cancelation Page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 36
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cancelation Page",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
