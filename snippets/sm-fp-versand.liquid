{%- comment -%} Steelmonks – Footer-Seite „versand“ (aus dem Prototyp erzeugt, port_footer.py) {%- endcomment -%}
<div class="smx" data-fp="versand">
<div class="sa-hero ft-hero dark"><div class="wrap">
    <nav class="crumbs" aria-label="Brotkrumen" style="color:var(--steel)"><a href="/" style="color:inherit">Startseite</a> / <span>Versand</span></nav>
    <div class="ft-top solo">
      <div>
        <p class="eyebrow" style="margin-top:14px">Rechtliches</p>
        <h1 class="sa-h1" data-split>Versand&shy;<span class="hl">bedingungen.</span></h1>
        <p class="sa-lead">Wie wir versenden, womit und wie lange es dauert.</p>
      </div>
      <span class="pxfx pxa-bob"><img src="{{ 'sm-px2_jakob_parcels.webp' | asset_url }}" alt="Pixel-Art: Jakob mit Paketen"></span>
    </div>
  </div></div>
  {%- render 'sm-fp-nav', aktiv: 'versand' -%}
  <section class="sa-sec paper"><div class="wrap">
    <div class="in-facts" style="margin:0 0 30px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
      <div><b>DHL</b><span>Versand innerhalb Deutschlands</span></div>
      {%- capture smv_gv -%}{% render 'sm-fakt', key: 'gratisversand_ab' %}{%- endcapture -%}
      <div><b>{% render 'sm-fakt', key: 'versandfertig' %}</b><span>Werktage bis versandfertig</span></div>
      <div><b>{% render 'sm-fakt', key: 'versandtag' %}</b><span>ist Versandtag, für Shop-Artikel und Sonderanfertigungen</span></div>
      <div><b>3 bis 5</b><span>Werktage Versand</span></div>
      <div><b>ab {{ smv_gv }}</b><span>versandkostenfrei in alle Länder, gilt für Shop-Bestellungen</span></div>
      <div><b>4,95 €</b><span>unter {{ smv_gv }} in Deutschland, nach Österreich und in die EU 12,95 €</span></div>
      <div><b>{% render 'sm-fakt', key: 'versand_sonder_de' %}</b><span>Versand für Sonderanfertigungen in Deutschland, in die EU {% render 'sm-fakt', key: 'versand_sonder_eu' %}</span></div>
    </div>
    <div class="ft-doc"><nav class="ft-toc" aria-label="Inhalt"><p class="eyebrow">Inhalt</p><ol></ol></nav><article class="ft-body">{% render 'sm-fakten-text', text: page.content %}</article></div>
  </div></section>
</div>
