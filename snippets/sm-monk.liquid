{%- comment -%}
  Bruder Funke, Testversion ohne KI: Seitenkontext als JSON und ein kleiner Loader. Nur mit settings.sm_monk_enabled,
  nie auf /pages/werkstatt. Vor einem Klick: keine Anfrage an Dritte, kein Speicherzugriff. sm-monk.css und sm-monk.js laden
  erst beim ersten Klick auf ein Element mit data-smmk (beim Überfahren schon vorab). Deep Links: ?moench=geschenk,
  ?moench=bestellung, #moench. #moench-r setzt der Mönch selbst beim Seitenwechsel nach einem Klick (Fortsetzen).
  Posen, Zielgruppen und Texte stehen in assets/sm-monk.js.
{%- endcomment -%}
{%- if settings.sm_monk_enabled -%}{%- unless request.path contains '/pages/werkstatt' -%}
{%- liquid
  assign mk_base = 'sm-monk.js' | asset_url | split: 'sm-monk.js' | first
  assign mk_pz = 0
  assign mk_gc = 0
  if product
    capture mk_pz
      render 'sm-monk-pz', p: product
    endcapture
    if product.gift_card?
      assign mk_gc = 1
    endif
  endif
  assign mk_zero = 0
  if search.performed and search.results_count == 0
    assign mk_zero = 1
  endif
-%}
<script type="application/json" id="smMonkCtx">{"ab":{{ mk_base | json }},"js":{{ 'sm-monk.js' | asset_url | json }},"css":{{ 'sm-monk.css' | asset_url | json }},"t":{{ template.name | json }},"s":{{ template.suffix | json }},"h":{{ product.handle | json }},"pz":{{ mk_pz }},"gc":{{ mk_gc }},"c":{{ collection.handle | json }},"pg":{{ page.handle | json }},"b":{{ blog.handle | json }},"n":{{ cart.item_count | default: 0 }},"z":{{ mk_zero }}}</script>
<script>(function(d,w){var s=0;function L(){if(s)return;s=1;var x=JSON.parse(d.getElementById('smMonkCtx').textContent),l=d.createElement('link'),f=function(){if(s<2){s=2;var j=d.createElement('script');j.src=x.js;d.head.appendChild(j)}};l.rel='stylesheet';l.href=x.css;l.onload=l.onerror=f;d.head.appendChild(l);setTimeout(f,3e3)}function g(i,e){L();w.SMMK?w.SMMK.open(i,e):(w.smMonkQ=w.smMonkQ||[]).push([i,e])}function k(e){return e.target.closest&&e.target.closest('[data-smmk]')}d.addEventListener('click',function(e){var b=k(e);if(b){e.preventDefault();g(b.getAttribute('data-smmk'),b)}});d.addEventListener('pointerover',function(e){k(e)&&L()},{passive:!0});d.addEventListener('focusin',function(e){k(e)&&L()});var m=location.search.match(/[?&]moench=(\w+)/),h=location.hash;if(m)g(m[1],'url');else if(h=='#moench-r')g('resume','url');else if(/^#moench/.test(h))g('open','url')})(document,window)</script>
<style>.smmk-hb{position:relative;display:inline-flex;justify-content:center;width:44px;height:44px;margin:0 2px;padding:0;border:0;background:none;cursor:pointer;overflow:hidden;flex:none}.smmk-hb img{width:66px;height:120px;max-width:none;margin-top:2px;image-rendering:pixelated}.smmk-hb b{position:absolute;right:0;top:2px;width:15px;height:15px;border-radius:50%;background:#ffd84a;color:#0b0c0e;font:800 10px/15px sans-serif;text-align:center}.smm-toggle{position:relative}.smm-toggle>.smmk-hb{position:absolute;left:43px;top:50%;width:36px;margin:-22px 0 0}@media (max-width:989px){.header__icons>.smmk-hb{display:none}}.smmk-chip{border-style:dashed!important}</style>
{%- if template.name == 'product' -%}<style>.smmk-cta--link{border:0;background:none;padding:6px 0;min-height:40px;color:#04c;text-decoration:underline;text-underline-offset:3px;font:inherit;font-weight:600;font-size:14px;cursor:pointer}</style><script>(function(){var c=document.querySelector('.smmk-pcta'),i=0;if(c)var t=setInterval(function(){var z=document.querySelector('.pplr-c-button');if(z){(z.closest('.shopify-app-block')||z).insertAdjacentElement('afterend',c);clearInterval(t)}else if(++i>40)clearInterval(t)},150)})()</script>
{%- elsif template.name == '404' or page.handle == 'sendungsverfolgung' -%}<style>.smmk-cta{display:inline-flex;align-items:center;min-height:44px;padding:8px 16px;border:2px solid #1b1d22;background:#ffd84a;color:#0b0c0e;font:inherit;font-weight:700;font-size:15px;cursor:pointer;box-shadow:2px 2px 0 #1b1d22}.smmk-404{margin:24px auto 0;display:flex;flex-direction:column;align-items:center;gap:6px}.smmk-404 img{image-rendering:pixelated;width:176px;height:210px}</style>
{%- endif -%}
{%- if page.handle == 'sendungsverfolgung' -%}
<div class="smmk-inl" id="smmkTrack" style="text-align:center;margin:10px auto 22px"><button type="button" class="smmk-cta" data-smmk="order">Fragen zu Deiner Bestellung? Frag den Mönch</button></div>
<script>(function(){var t=document.getElementById('smmkTrack'),h=document.querySelector('main h1,main h2');if(!t||!h)return;var n=h.nextElementSibling;(n&&!n.querySelector('details,summary')&&n.tagName!=='DETAILS'?n:h).insertAdjacentElement('afterend',t)})();</script>
{%- endif -%}
{%- endunless -%}{%- endif -%}
