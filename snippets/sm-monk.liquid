{%- comment -%}
  Bruder Funke, Testversion ohne KI: Seitenkontext als JSON und ein kleiner Loader. Nur mit settings.sm_monk_enabled,
  nie auf /pages/werkstatt. Vor einem Klick: keine Anfrage an Dritte, kein Speicherzugriff. sm-monk.css und sm-monk.js laden
  erst beim ersten Klick auf ein Element mit data-smmk (beim Überfahren schon vorab). Deep Links: ?moench=geschenk,
  ?moench=bestellung, #moench. #moench-r setzt der Mönch selbst beim Seitenwechsel nach einem Klick (Fortsetzen).
  Posen, Zielgruppen und Texte stehen in assets/sm-monk.js.
{%- endcomment -%}
{%- if settings.sm_monk_enabled -%}{%- unless request.path contains '/pages/werkstatt' -%}
{%- liquid
  assign mk_base = 'sm-monk.js' | asset_url | split: 'sm-monk.js' | first
  assign mk_pz = 0
  assign mk_gc = 0
  if product
    capture mk_pz
      render 'sm-monk-pz', p: product
    endcapture
    if product.gift_card?
      assign mk_gc = 1
    endif
  endif
  assign mk_zero = 0
  if search.performed and search.results_count == 0
    assign mk_zero = 1
  endif
-%}
<script type="application/json" id="smMonkCtx">{"ab":{{ mk_base | json }},"js":{{ 'sm-monk.js' | asset_url | json }},"css":{{ 'sm-monk.css' | asset_url | json }},"t":{{ template.name | json }},"s":{{ template.suffix | json }},"h":{{ product.handle | json }},"pz":{{ mk_pz }},"gc":{{ mk_gc }},"c":{{ collection.handle | json }},"pg":{{ page.handle | json }},"b":{{ blog.handle | json }},"n":{{ cart.item_count | default: 0 }},"z":{{ mk_zero }}}</script>
<script>(function(d,w){var s=0;function L(){if(s)return;s=1;var x=JSON.parse(d.getElementById('smMonkCtx').textContent),l=d.createElement('link'),f=function(){if(s<2){s=2;var j=d.createElement('script');j.src=x.js;d.head.appendChild(j)}};l.rel='stylesheet';l.href=x.css;l.onload=l.onerror=f;d.head.appendChild(l);setTimeout(f,3e3)}function g(i,e){L();w.SMMK?w.SMMK.open(i,e):(w.smMonkQ=w.smMonkQ||[]).push([i,e])}function k(e){return e.target.closest&&e.target.closest('[data-smmk]')}d.addEventListener('click',function(e){var b=k(e);if(b){e.preventDefault();g(b.getAttribute('data-smmk'),b)}});d.addEventListener('pointerover',function(e){k(e)&&L()},{passive:!0});d.addEventListener('focusin',function(e){k(e)&&L()});var m=location.search.match(/[?&]moench=(\w+)/),h=location.hash;if(m)g(m[1],'url');else if(h=='#moench-r')g('resume','url');else if(/^#moench/.test(h))g('open','url')})(document,window)</script>
<style>.smmk-hb{position:relative;display:inline-grid;place-items:center;width:44px;height:44px;margin:0 2px;padding:0;border:0;background:none;cursor:pointer;overflow:visible;flex:none}.smmk-hb i{position:relative;display:block;width:34px;height:34px;border-radius:50%;background:#0044cc;overflow:hidden;box-shadow:0 0 0 2px #fff,0 0 0 3px rgba(11,12,14,.12)}.smmk-hb img{position:absolute;left:-22px;top:-14px;width:66px;height:120px;max-width:none;image-rendering:pixelated}.smmk-hb b{position:absolute;right:2px;top:2px;width:14px;height:14px;border-radius:50%;background:#ff6b1f;color:#0b0c0e;font:700 9px/14px 'IBM Plex Mono',monospace;text-align:center;box-shadow:0 0 0 2px #fff}.smmk-hb:focus-visible{outline:2px solid #0044cc;outline-offset:3px}.smm-toggle{position:relative}.smm-toggle>.smmk-hb{position:absolute;left:44px;top:50%;margin:-22px 0 0}.smm-toggle>.smmk-hb i{width:32px;height:32px}.smm-toggle>.smmk-hb img{left:-22px;top:-16px}@media (max-width:989px){.header__icons>.smmk-hb{display:none}}@media (prefers-reduced-motion:no-preference){.smmk-hb b{animation:smmk-bd .3s steps(2) 2s 3}.smmk-hb i{transition:transform .2s steps(2)}.smmk-hb:hover i,.smmk-hb:focus-visible i{transform:translateY(-2px)}@keyframes smmk-bd{50%{transform:translateY(-3px)}}}</style>
{%- capture mk_ask -%}html body .smmk-ask{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:4px 18px 4px 4px;border:1px solid rgba(11,12,14,.12);border-radius:999px;background:#fff;color:#0b0c0e;font:inherit;font-weight:600;font-size:14.5px;line-height:1.3;text-align:left;cursor:pointer;transition:border-color .2s}html body .smmk-ask:hover{border-color:#0b0c0e}html body .smmk-ask:focus-visible{outline:2px solid #0044cc;outline-offset:2px}html body .smmk-ask-av{position:relative;flex:none;display:block;width:36px;height:36px;border-radius:50%;background:#0044cc;overflow:hidden}html body :is(.smmk-ask,.smmk-chip) .smmk-ask-av img{position:absolute;left:-20px;top:-14px;width:66px;height:120px;max-width:none;margin:0;image-rendering:pixelated}html body .smmk-ask em{font-style:normal;color:#0044cc}{%- endcapture -%}
{%- if template.name == 'product' -%}<style>{{ mk_ask }}.smmk-ask--pdp[class]{border:0;background:transparent;padding-left:0;font-size:14px}.smmk-ask--pdp[class]:hover{border:0}.smmk-ask--pdp:hover em{text-decoration:underline;text-underline-offset:3px}</style><script>(function(){var c=document.querySelector('.smmk-pcta'),i=0;if(c)var t=setInterval(function(){var z=document.querySelector('.pplr-c-button');if(z){(z.closest('.shopify-app-block')||z).insertAdjacentElement('afterend',c);clearInterval(t)}else if(++i>40)clearInterval(t)},150)})()</script>
{%- elsif template.name == '404' -%}<style>{{ mk_ask }}.smmk-404{margin:32px auto 0;display:flex;align-items:center;justify-content:center;gap:12px 24px;flex-wrap:wrap;text-align:left}.smmk-404>img{image-rendering:pixelated;width:176px;height:210px}.smmk-404-b{position:relative;margin:0 0 14px;padding:12px 16px;max-width:290px;background:#fff;border:1px solid rgba(11,12,14,.12);border-radius:14px;font-size:15px;line-height:1.45;color:#0b0c0e}.smmk-404-b::before{content:"";position:absolute;left:-7px;top:22px;width:12px;height:12px;background:#fff;border:solid rgba(11,12,14,.12);border-width:0 0 1px 1px;transform:rotate(45deg)}@media (max-width:599px){.smmk-404-b::before{left:44px;top:-7px;border-width:1px 0 0 1px}}html.smmk-out .smmk-404>img{visibility:hidden}</style>
{%- elsif template.name == 'index' or page.handle == 'sendungsverfolgung' or page.handle == 'fragen' -%}<style>{{ mk_ask }}.smmk-chip{padding:3px 14px 3px 4px!important}.smmk-chip .smmk-ask-av{width:30px;height:30px}html body .smmk-chip .smmk-ask-av img{left:-23px;top:-17px}</style>
{%- endif -%}
{%- if page.handle == 'sendungsverfolgung' -%}
<div class="smmk-inl" id="smmkTrack" style="text-align:center;margin:24px auto 28px"><button type="button" class="smmk-ask" data-smmk="order" data-smmk-src="track"><span class="smmk-ask-av"><img src="{{ 'sm-pxm_lupe.webp' | asset_url }}" alt="" width="66" height="120"></span>Fragen zu Deiner Bestellung?</button></div>
<script>(function(){var t=document.getElementById('smmkTrack'),h=document.querySelector('main h1,main h2');if(!t||!h)return;var n=h.nextElementSibling;(n&&!n.querySelector('details,summary')&&n.tagName!=='DETAILS'?n:h).insertAdjacentElement('afterend',t)})();</script>
{%- endif -%}
{%- endunless -%}{%- endif -%}
