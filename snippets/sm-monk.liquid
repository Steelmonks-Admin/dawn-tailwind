{%- comment -%}
  Bruder Funke, Testversion ohne KI: Seitenkontext als JSON und ein kleiner Loader. Nur mit settings.sm_monk_enabled,
  nie auf /pages/werkstatt. Vor einem Klick: keine Anfrage an Dritte, kein Speichern. sm-monk.css und sm-monk.js laden
  erst beim ersten Klick auf ein Element mit data-smmk (beim Überfahren schon vorab). Deep Links: ?moench=geschenk,
  ?moench=bestellung, #moench. Nach einem Klick merkt sich sessionStorage "smMonk" Hinweise für die nächste Seite.
{%- endcomment -%}
{%- if settings.sm_monk_enabled -%}{%- unless request.path contains '/pages/werkstatt' -%}
{%- liquid
  assign mk_base = 'sm-monk.js' | asset_url | split: 'sm-monk.js' | first
  assign mk_pz = 0
  if product
    assign mk_pz = 1
    if product.tags contains 'Mengenwahl'
      assign mk_pz = 0
    endif
  endif
  assign mk_zero = 0
  if search.performed and search.results_count == 0
    assign mk_zero = 1
  endif
-%}
<script type="application/json" id="smMonkCtx">{"ab":{{ mk_base | json }},"a":{"sketch":{{ 'sm-px4_monk_sketch.webp' | asset_url | split: '/assets/' | last | json }},"search":{{ 'sm-px3_monk_search.webp' | asset_url | split: '/assets/' | last | json }},"curator":{{ 'sm-px4_monk_curator.webp' | asset_url | split: '/assets/' | last | json }},"measure":{{ 'sm-px4_monk_measure.webp' | asset_url | split: '/assets/' | last | json }},"pc":{{ 'sm-px2_monk_pc.webp' | asset_url | split: '/assets/' | last | json }},"shrug":{{ 'sm-px3_monk_shrug.webp' | asset_url | split: '/assets/' | last | json }},"coffee":{{ 'sm-px3_monk_coffee.webp' | asset_url | split: '/assets/' | last | json }},"chest":{{ 'sm-px2_chest.webp' | asset_url | split: '/assets/' | last | json }},"lupe":{{ 'sm-pxm_lupe.webp' | asset_url | split: '/assets/' | last | json }}},"js":{{ 'sm-monk.js' | asset_url | json }},"css":{{ 'sm-monk.css' | asset_url | json }},"t":{{ template.name | json }},"s":{{ template.suffix | json }},"pt":{{ request.page_type | json }},"h":{{ product.handle | json }},"pz":{{ mk_pz }},"c":{{ collection.handle | json }},"pg":{{ page.handle | json }},"b":{{ blog.handle | json }},"n":{{ cart.item_count | default: 0 }},"z":{{ mk_zero }},"aud":["Handwerker|geschenke-fur-handwerker,zunftzeichen|1","Feuerwehr|feuerwehr-geschenke|1","Paare|geschenke-fur-paare|1","Familie|geschenke-fur-familien|1","Zuhause|einweihungsgeschenke|1","Für Ihn|gechenke-fur-ihn","Für Sie|geschenke-fur-sie","Eltern|geschenke-fur-eltern","Soldaten|geschenke-fuer-bundeswehr-soldaten-und-veteranen","THW|thw-geschenke","Sportler|geschenke-fur-sportler","Tierfreunde|pferde-geschenke,tiere-aus-metall","Motorrad|motorrad-geschenke","Garten|rost-gartendeko"]}</script>
<script>(function(d,w){var C,s=0;function c(){return C||(C=JSON.parse(d.getElementById('smMonkCtx').textContent))}function L(){if(s)return;s=1;var x=c(),l=d.createElement('link'),f=function(){if(s<2){s=2;var j=d.createElement('script');j.src=x.js;d.head.appendChild(j)}};l.rel='stylesheet';l.href=x.css;l.onload=l.onerror=f;d.head.appendChild(l);setTimeout(f,3e3)}function g(i,e){L();w.SMMK?w.SMMK.open(i,e):(w.smMonkQ=w.smMonkQ||[]).push([i,e])}function k(e){return e.target.closest&&e.target.closest('[data-smmk]')}d.addEventListener('click',function(e){var b=k(e);if(b){e.preventDefault();g(b.getAttribute('data-smmk'),b)}});d.addEventListener('pointerover',function(e){k(e)&&L()},{passive:!0});d.addEventListener('focusin',function(e){k(e)&&L()});var m=location.search.match(/[?&]moench=(\w+)/),o;if(m)g(m[1]);else if(/^#moench/.test(location.hash))g('open');else try{o=JSON.parse(sessionStorage.getItem('smMonk'));if(o&&(o.cue&&o.cue.u==location.pathname||o.nb!=null&&c().n!=o.nb))g('resume')}catch(e){}})(document,window)</script>
<style>.smmk-hb{position:relative;display:inline-flex;justify-content:center;width:44px;height:44px;margin:0 2px;padding:0;border:0;background:none;cursor:pointer;overflow:hidden;flex:none}.smmk-hb img{width:66px;height:120px;max-width:none;margin-top:2px;image-rendering:pixelated}.smmk-hb b{position:absolute;right:0;top:2px;width:15px;height:15px;border-radius:50%;background:#ffd84a;color:#0b0c0e;font:800 10px/15px sans-serif;text-align:center}@media (max-width:989px){.header__icons>.smmk-hb{display:none}}.smmk-chip{border-style:dashed!important}</style>
{%- if template.name == 'product' or template.name == '404' or page.handle == 'sendungsverfolgung' -%}<style>.smmk-cta{display:inline-flex;align-items:center;min-height:44px;padding:8px 16px;border:2px solid #1b1d22;background:#ffd84a;color:#0b0c0e;font:inherit;font-weight:700;font-size:15px;cursor:pointer;box-shadow:2px 2px 0 #1b1d22}.smmk-cta--link{border:0;background:none;box-shadow:none;padding:6px 0;min-height:40px;color:#0044cc;text-decoration:underline;text-underline-offset:3px;font-weight:600;font-size:14px}.smmk-404{margin:24px auto 0;display:flex;flex-direction:column;align-items:center;gap:6px}.smmk-404 img{image-rendering:pixelated;width:176px;height:210px}</style>{%- endif -%}
{%- if template.name == 'product' -%}<script>(function(){var c=document.querySelector('.smmk-pcta'),i=0;if(c)var t=setInterval(function(){var z=document.querySelector('.pplr-c-button');if(z){(z.closest('.shopify-app-block')||z).insertAdjacentElement('afterend',c);clearInterval(t)}else if(++i>40)clearInterval(t)},150)})()</script>{%- endif -%}
{%- if page.handle == 'sendungsverfolgung' -%}
<div class="smmk-inl" id="smmkTrack" style="text-align:center;margin:10px auto 22px"><button type="button" class="smmk-cta" data-smmk="order">Fragen zu Deiner Bestellung? Frag den Mönch</button></div>
<script>(function(){var t=document.getElementById('smmkTrack'),h=document.querySelector('main h1,main h2');if(!t||!h)return;var n=h.nextElementSibling;(n&&!n.querySelector('details,summary')&&n.tagName!=='DETAILS'?n:h).insertAdjacentElement('afterend',t)})();</script>
{%- endif -%}
{%- endunless -%}{%- endif -%}
