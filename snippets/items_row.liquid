<article class='twcss-flex twcss-items-center twcss-flex-col twcss-gap-4 twcss-mb-6'>
  {% comment %} Title {% endcomment %}
  <h3 class='twcss-text-center twcss-text-[22px] twcss-font-semibold'>
    {{ block.settings.title }}
  </h3>

  {% comment %} Row of 4 images {% endcomment %}
  <div class='twcss-grid twcss-grid-cols-2 md:twcss-grid-cols-4 twcss-gap-6 twcss-max-w-[1600px] twcss-mx-4'>
    <a
      href='{{ block.settings.item1_link }}'
      class='twcss-border-[1px] twcss-aspect-square twcss-border-brandblack twcss-shadow-md twcss-rounded-lg'
    >
      <img
        src='{{ block.settings.item1.image | image_url: width: 800 }}'
        srcset='{{ block.settings.item1.image | image_url: width: 400 }} 400w, {{ block.settings.item1.image | image_url: width: 800 }} 800w, {{ block.settings.item1.image | image_url: width: 1200 }} 1200w'
        sizes='(max-width: 749px) 50vw, 25vw'
        loading='lazy'
        decoding='async'
        alt='{{ block.settings.item1.alt | default: block.settings.title | default: "Steelmonks Kollektion" | escape }}'
        class='twcss-w-full'
        width='800'
        height='800'
      >
    </a>
    <a
      href='{{ block.settings.item2_link }}'
      class='twcss-border-[1px] twcss-aspect-square twcss-border-brandblack twcss-shadow-md twcss-rounded-lg'
    >
      <img
        src='{{ block.settings.item2.image | image_url: width: 800 }}'
        srcset='{{ block.settings.item2.image | image_url: width: 400 }} 400w, {{ block.settings.item2.image | image_url: width: 800 }} 800w, {{ block.settings.item2.image | image_url: width: 1200 }} 1200w'
        sizes='(max-width: 749px) 50vw, 25vw'
        loading='lazy'
        decoding='async'
        alt='{{ block.settings.item2.alt | default: block.settings.title | default: "Steelmonks Kollektion" | escape }}'
        class='twcss-w-full'
        width='800'
        height='800'
      >
    </a>
    <a
      href='{{ block.settings.item3_link }}'
      class='twcss-border-[1px] twcss-aspect-square twcss-border-brandblack twcss-shadow-md twcss-rounded-lg'
    >
      <img
        src='{{ block.settings.item3.image | image_url: width: 800 }}'
        srcset='{{ block.settings.item3.image | image_url: width: 400 }} 400w, {{ block.settings.item3.image | image_url: width: 800 }} 800w, {{ block.settings.item3.image | image_url: width: 1200 }} 1200w'
        sizes='(max-width: 749px) 50vw, 25vw'
        loading='lazy'
        decoding='async'
        alt='{{ block.settings.item3.alt | default: block.settings.title | default: "Steelmonks Kollektion" | escape }}'
        class='twcss-w-full'
        width='800'
        height='800'
      >
    </a>
    <a
      href='{{ block.settings.item4_link }}'
      class='twcss-border-[1px] twcss-aspect-square twcss-border-brandblack twcss-shadow-md twcss-rounded-lg'
    >
      <img
        src='{{ block.settings.item4.image | image_url: width: 800 }}'
        srcset='{{ block.settings.item4.image | image_url: width: 400 }} 400w, {{ block.settings.item4.image | image_url: width: 800 }} 800w, {{ block.settings.item4.image | image_url: width: 1200 }} 1200w'
        sizes='(max-width: 749px) 50vw, 25vw'
        loading='lazy'
        decoding='async'
        alt='{{ block.settings.item4.alt | default: block.settings.title | default: "Steelmonks Kollektion" | escape }}'
        class='twcss-w-full'
        width='800'
        height='800'
      >
    </a>
  </div>

  {% comment %} CTA {% endcomment %}
  <a href='{{ block.settings.cta_link }}' class='btn btn-primary twcss-mx-auto'>{{ block.settings.cta_text }}</a>
</article>
