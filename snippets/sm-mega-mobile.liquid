{%- comment -%} Handy-Menü: hell, gleiche Punkte wie im Shop, mit Bildern; ersetzt header-drawer {%- endcomment -%}
{%- assign smm_menu = section.settings.menu -%}
<div class="smm-toggle"><button type="button" class="header__icon header__icon--menu link focus-inset smm-burger" aria-label="Menü öffnen" aria-expanded="false" aria-controls="smmMob"><span>{{- 'icon-hamburger.svg' | inline_asset_content -}}</span></button>{%- if settings.sm_monk_enabled -%}{%- render 'sm-monk-btn' -%}{%- endif -%}</div>
<div class="smm smm-mob" id="smmMob" hidden role="dialog" aria-modal="true" aria-label="Menü">
  <div class="mob-head">
    {%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 360 | image_tag: alt: shop.name, height: 20, width: 142, loading: 'lazy' }}{%- else -%}<b>{{ shop.name }}</b>{%- endif -%}
    <button type="button" class="mob-x" aria-label="Menü schließen"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
  {%- for link in smm_menu.links -%}
    {%- if link.links != blank -%}
      {%- assign allpages = true -%}{%- for c in link.links -%}{%- if c.type != 'page_link' -%}{%- assign allpages = false -%}{%- endif -%}{%- endfor -%}
      <div class="acc">
        <button type="button" class="acc-h" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="smmAcc{{ forloop.index }}">{{ link.title | remove: '--highlighted-red' | remove: '--highlighted' | strip | escape }}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="acc-b" id="smmAcc{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %}>
          {%- if link.levels > 1 -%}
            {%- for g in link.links -%}<p class="mg-h">{{ g.title | remove: '--highlighted-red' | remove: '--highlighted' | strip | escape }}</p><ul class="ml sm">{%- for c in g.links -%}{%- render 'sm-mega-li', c: c -%}{%- endfor -%}</ul>{%- endfor -%}
          {%- elsif allpages -%}
            <div class="mcs">
            {%- for c in link.links -%}
              {%- assign fin = false -%}{%- if c.object.handle == 'werkstatt' or c.object.handle == 'dein-wappen' -%}{%- assign fin = true -%}{%- endif -%}{%- capture a -%}{% render 'sm-mega-img', link: c, w: 400, b: fin %}{%- endcapture -%}{%- assign a = a | strip | split: '|' -%}
              {%- assign t = c.title | remove: '--highlighted-red' | remove: '--highlighted' | strip | split: ' (' -%}
              <a class="mc" href="{{ c.url }}"><div class="mc-i {{ a[1] }}">{% if a[0] != blank %}<img src="{{ a[0] }}" alt="" loading="lazy">{% endif %}</div><div class="mc-t"><b>{{ t.first | escape }}</b>{% if t.size > 1 %}<span>{{ t.last | remove: ')' | escape }}</span>{% endif %}</div></a>
            {%- endfor -%}
            </div>
          {%- else -%}
            <ul class="ml">{%- for c in link.links -%}{%- render 'sm-mega-li', c: c -%}{%- endfor -%}</ul>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      <a class="acc-h acc-link" href="{{ link.url }}">{{ link.title | remove: '--highlighted-red' | remove: '--highlighted' | strip | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
  {%- if settings.sm_monk_enabled -%}<a class="mob-px" href="{{ routes.root_url }}#moench" data-smmk="open"><img src="{{ 'sm-px4_monk_sketch.webp' | asset_url }}" alt="Bruder Funke in Pixel-Art" loading="lazy" width="68" height="70" style="image-rendering:pixelated"><span><b>Frag den Mönch</b>Bruder Funke hilft Dir beim Geschenk. Testversion, noch ohne KI.</span></a>{%- endif -%}
  <a class="mob-px" href="/pages/kontakt"><img src="{{ 'sm-px3_jakob_letter.webp' | asset_url }}" alt="Jakob in Pixel-Art mit einem Brief" loading="lazy" width="58" height="70"><span><b>Fragen zu Deiner Idee?</b>Schreib uns, wir antworten persönlich.</span></a>
  {%- if shop.customer_accounts_enabled -%}<p class="mob-acc"><a class="mob-btn" href="{{ routes.account_url }}">{% if customer %}Mein Konto{% else %}Einloggen{% endif %}</a></p>{%- endif -%}
</div>
