{%- comment -%}
  Ersetzt in einem Text die Platzhalter der zentralen Fakten (Shop-Metafelder steelmonks.fakt_*, siehe sm-fakt):
    [versandfertig] 2 bis 5 · [versandtag] Freitag · [entwurf] 1 bis 2 · [sonder_fertigung] 7 bis 10
    [gratisversand_ab] 99 € · [versand_sonder_de] 4,95 € · [versand_sonder_eu] 14,90 € · [montage_frei_ab] 150 €
    [befestigungsset_preis] 9,45 € · dazu [bestellungen] (alle Bestellungen seit 2020, sm-bestellungen)
  Aufruf: {% render 'sm-fakten-text', text: block.settings.text %}
  Mit Filtern danach: {%- capture t -%}{% render 'sm-fakten-text', text: x %}{%- endcapture -%}{{ t | escape }}
  Die Werte enthalten kein HTML, der Text bleibt also so sicher oder unsicher wie vorher.
{%- endcomment -%}
{%- liquid
  assign smft = text | append: ''
  if smft contains '['
    assign smft_keys = 'versandfertig,versandtag,entwurf,sonder_fertigung,gratisversand_ab,versand_sonder_de,versand_sonder_eu,montage_frei_ab,befestigungsset_preis' | split: ','
    for smft_k in smft_keys
      assign smft_ph = '[' | append: smft_k | append: ']'
      if smft contains smft_ph
        capture smft_v
          render 'sm-fakt', key: smft_k
        endcapture
        assign smft = smft | replace: smft_ph, smft_v
      endif
    endfor
    if smft contains '[bestellungen]'
      capture smft_v
        render 'sm-bestellungen'
      endcapture
      assign smft = smft | replace: '[bestellungen]', smft_v
    endif
  endif
  echo smft
-%}
